# --------------------------------------------------------------------
# AZURE POC CONFIGURATION TEMPLATE
# --------------------------------------------------------------------
#
# THESE ARE RESOURCE LOCATORS — NOT SECRETS.
#
# Do not put:
#
#     Azure OpenAI keys
#     Service Bus connection strings
#     storage account keys
#     Azure DevOps PATs
#
# into this file.
#
# The preferred Azure design uses managed identity/keyless authentication
# wherever the selected service and enterprise configuration permit it.
#
# Values below are examples showing the required configuration shape.
# They are NOT deployable enterprise values.
L1_RUNTIME_MODE=azure_poc
L1_ENVIRONMENT_NAME=azure-poc
L1_SERVICE_NAME=l1-engineering-automation
# Azure subscription/resource group
L1_AZURE_SUBSCRIPTION_ID=<ENTERPRISE-SUBSCRIPTION-ID>
L1_AZURE_RESOURCE_GROUP=<ENTERPRISE-RESOURCE-GROUP>
# Azure App Configuration
L1_APP_CONFIGURATION_ENDPOINT=https://<STORE>.azconfig.io
# Evidence storage
L1_EVIDENCE_STORAGE_ACCOUNT=<STORAGE-ACCOUNT>
L1_EVIDENCE_CONTAINER=<EVIDENCE-CONTAINER>
# Azure Service Bus
L1_SERVICE_BUS_NAMESPACE=<SERVICE-BUS-NAMESPACE>
L1_TASK_QUEUE_NAME=<TASK-QUEUE>
# Separate execution boundaries
L1_CHANGE_EXECUTION_JOB_NAME=<CHANGE-EXECUTION-JOB>
L1_RELEASE_GATE_JOB_NAME=<RELEASE-GATE-JOB>
L1_HIDDEN_ORACLE_JOB_NAME=<HIDDEN-ORACLE-JOB>
# Model endpoint
#
# Do not put the API key here.
L1_AZURE_OPENAI_ENDPOINT=https://<RESOURCE>.openai.azure.com
L1_AZURE_OPENAI_DEPLOYMENT=<DEPLOYMENT-NAME>
# Azure DevOps workflow identity
L1_AZURE_DEVOPS_ORGANIZATION=<ORGANIZATION>
L1_AZURE_DEVOPS_PROJECT=<PROJECT>
L1_AZURE_DEVOPS_REPOSITORY=<REPOSITORY>

