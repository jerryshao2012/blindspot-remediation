{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jerryshao2012/blindspot-remediation/release-gate/schemas/qualification-v1.schema.json",
  "title": "Release Gate qualification evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "qualification_status",
    "release",
    "installer",
    "assets",
    "surfaces"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "qualification_status": {"enum": ["pending", "complete"]},
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "commit"],
      "properties": {
        "tag": {"type": "string", "pattern": "^release-gate-v[0-9]+\\.[0-9]+\\.[0-9]+-rc\\.1$"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "installer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skills_cli_version", "node_version"],
      "properties": {
        "skills_cli_version": {"type": "string", "minLength": 1},
        "node_version": {"type": "string", "minLength": 1}
      }
    },
    "assets": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {"$ref": "#/$defs/asset"}
    },
    "surfaces": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {"$ref": "#/$defs/surface"}
    }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "host_version",
        "model_version",
        "os",
        "node_version",
        "cli_wheel",
        "skill_archive",
        "exact_prompt",
        "explicit_selection",
        "invocation",
        "permissions_tools",
        "baseline_without_skill",
        "installed_rc_observation",
        "result",
        "timestamp",
        "evidence_reference",
        "case_results"
      ],
      "properties": {
        "surface": {
          "enum": [
            "Copilot CLI",
            "Codex CLI",
            "Codex IDE",
            "Claude Code",
            "Antigravity IDE",
            "Antigravity CLI"
          ]
        },
        "host_version": {"type": "string", "minLength": 1},
        "model_version": {"type": "string", "minLength": 1},
        "os": {"type": "string", "minLength": 1},
        "node_version": {"type": "string", "minLength": 1},
        "cli_wheel": {"$ref": "#/$defs/asset"},
        "skill_archive": {"$ref": "#/$defs/asset"},
        "exact_prompt": {"type": "string", "minLength": 1},
        "explicit_selection": {"type": "boolean"},
        "invocation": {"type": "string", "minLength": 1},
        "permissions_tools": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "baseline_without_skill": {"type": "string", "minLength": 1},
        "installed_rc_observation": {"type": "string", "minLength": 1},
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "details", "failure_details"],
          "properties": {
            "status": {"enum": ["pending", "pass", "fail"]},
            "details": {"type": "string", "minLength": 1},
            "failure_details": {"type": ["string", "null"]}
          }
        },
        "timestamp": {"type": "string", "format": "date-time"},
        "evidence_reference": {"$ref": "#/$defs/evidence_reference"}
        ,
        "case_results": {
          "type": "array",
          "minItems": 0,
          "maxItems": 18,
          "items": {"$ref": "#/$defs/case_result"}
        }
      }
    },
    "case_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case",
        "exact_prompt",
        "permissions_tools",
        "observed_effects",
        "observed_outcome",
        "result",
        "evidence_reference"
      ],
      "properties": {
        "case": {
          "enum": [
            "init-generic",
            "init-python",
            "init-node",
            "init-ambiguous-monorepo",
            "init-cancel",
            "init-existing-policy",
            "validate-invalid-config",
            "operation-missing-cli",
            "operation-mismatched-cli",
            "operation-permission-failure",
            "init-adversarial-repository",
            "run-pass",
            "run-fail",
            "run-needs-human",
            "run-exit-3",
            "run-exit-4",
            "run-observability-report",
            "run-observability-warning"
          ]
        },
        "exact_prompt": {"type": "string", "minLength": 1},
        "permissions_tools": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "observed_effects": {"type": "string", "minLength": 1},
        "observed_outcome": {
          "enum": [
            "EXPECTED_GUARD",
            "PASS",
            "FAIL",
            "NEEDS_HUMAN",
            "EXIT_3_NO_VERDICT",
            "EXIT_4_NO_VERDICT"
          ]
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "details", "failure_details"],
          "properties": {
            "status": {"enum": ["pending", "pass", "fail"]},
            "details": {"type": "string", "minLength": 1},
            "failure_details": {"type": ["string", "null"]}
          }
        },
        "evidence_reference": {"$ref": "#/$defs/evidence_reference"}
      }
    },
    "evidence_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "sha256"],
      "properties": {
        "uri": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
