{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:release-gate:schema:manifest:v1",
  "title": "Release Gate evidence manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "run_id",
    "hash_algorithm",
    "created_at",
    "started_at",
    "finished_at",
    "duration_ms",
    "base_commit",
    "candidate_tree",
    "patch_sha256",
    "config_sha256",
    "engine_version",
    "platform",
    "runtime",
    "reason_codes",
    "executions",
    "artifacts"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "run_id": {
      "$ref": "#/$defs/runId"
    },
    "hash_algorithm": {
      "const": "sha256"
    },
    "created_at": {
      "type": "string",
      "maxLength": 64,
      "format": "date-time"
    },
    "started_at": {
      "type": "string",
      "maxLength": 64,
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "maxLength": 64,
      "format": "date-time"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "base_commit": {
      "$ref": "#/$defs/gitObject"
    },
    "candidate_tree": {
      "$ref": "#/$defs/gitObject"
    },
    "patch_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "config_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "engine_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "platform": {
      "$ref": "#/$defs/platformIdentity"
    },
    "runtime": {
      "$ref": "#/$defs/runtimeIdentity"
    },
    "reason_codes": {
      "$ref": "#/$defs/runReasonCodes"
    },
    "executions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 320,
      "items": {
        "$ref": "#/$defs/execution"
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4740,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/artifact"
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": ["path"],
            "properties": {
              "path": {
                "const": "result.json"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": ["path"],
            "properties": {
              "path": {
                "const": "candidate.patch"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": ["path"],
            "properties": {
              "path": {
                "const": "effective-config.json"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": ["path"],
            "properties": {
              "path": {
                "const": "trace.json"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    }
  },
  "$defs": {
    "runId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Portable evidence-directory component.",
      "pattern": "^(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.|$))[A-Za-z0-9](?:[A-Za-z0-9._-]{0,126}[A-Za-z0-9_-])?(?![\\s\\S])"
    },
    "controlId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "Portable preparation or check identifier.",
      "pattern": "^(?!(?:con|prn|aux|nul|com[1-9]|lpt[1-9])(?:\\.|$))[a-z](?:[a-z0-9._-]{0,62}[a-z0-9_-])?(?![\\s\\S])"
    },
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "gitObject": {
      "type": "string",
      "minLength": 40,
      "maxLength": 64,
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})(?![\\s\\S])"
    },
    "runReasonCodes": {
      "type": "array",
      "maxItems": 22,
      "uniqueItems": true,
      "items": {
        "enum": [
          "ASSERTION_FAILED",
          "ASSERTION_OPERAND_ERROR",
          "COMMAND_EXIT_ERROR",
          "COMMAND_EXIT_UNCLASSIFIED",
          "COMMAND_FAILED",
          "COMMAND_SIGNALLED",
          "COMMAND_SPAWN_FAILED",
          "COMMAND_TIMED_OUT",
          "CONTROL_LAUNCHER_REVIEW",
          "EVIDENCE_BUDGET_EXHAUSTED",
          "INHERITED_ENVIRONMENT_MISSING",
          "OPERATOR_INTERRUPTED",
          "PATH_FORBIDDEN",
          "PATH_OUTSIDE_ALLOWED",
          "PATH_REVIEW_REQUIRED",
          "POLICY_FILE_CHANGED",
          "PREPARATION_FAILED",
          "REPORT_PARSE_FAILED",
          "REPORT_PATH_UNSAFE",
          "REPORT_TOO_LARGE",
          "REQUIRED_CONTROL_SKIPPED",
          "REQUIRED_REPORT_MISSING"
        ]
      }
    },
    "platformIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "system", "release", "machine"],
      "properties": {
        "family": {
          "enum": ["linux", "macos", "windows"]
        },
        "system": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "release": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "machine": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "runtimeIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation", "version", "executable", "executable_sha256"],
      "properties": {
        "implementation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "executable": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "executable_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control_id",
        "phase",
        "side",
        "argv",
        "cwd",
        "environment_keys",
        "started_at",
        "finished_at",
        "duration_ms",
        "classification",
        "exit_code",
        "timed_out",
        "reason_codes",
        "metrics"
      ],
      "properties": {
        "control_id": {
          "$ref": "#/$defs/controlId",
          "description": "Globally unique preparation or check ID."
        },
        "phase": {
          "enum": ["prepare", "check"]
        },
        "side": {
          "enum": ["base", "candidate"]
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "cwd": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
        },
        "environment_keys": {
          "type": "array",
          "maxItems": 198,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        },
        "started_at": {
          "type": "string",
          "maxLength": 64,
          "format": "date-time"
        },
        "finished_at": {
          "type": "string",
          "maxLength": 64,
          "format": "date-time"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "classification": {
          "enum": ["pass", "fail", "error", "skipped"]
        },
        "exit_code": {
          "type": ["integer", "null"],
          "minimum": -2147483648,
          "maximum": 4294967295
        },
        "timed_out": {
          "type": "boolean"
        },
        "reason_codes": {
          "$ref": "#/$defs/executionReasonCodes"
        },
        "metrics": {
          "type": "object",
          "maxProperties": 64,
          "description": "Assertion-referenced scalar metrics keyed as <report-id>#<RFC6901-pointer>.",
          "propertyNames": {
            "type": "string",
            "minLength": 2,
            "maxLength": 1089,
            "pattern": "^(?!(?:con|prn|aux|nul|com[1-9]|lpt[1-9])(?:\\.|#))[a-z](?:[a-z0-9._-]{0,62}[a-z0-9_-])?#(?:/(?:[^~/]|~[01])*)*(?![\\s\\S])"
          },
          "additionalProperties": {
            "$ref": "#/$defs/scalar"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["classification"],
            "properties": {
              "classification": {
                "const": "pass"
              }
            }
          },
          "then": {
            "properties": {
              "reason_codes": {
                "$ref": "#/$defs/passExecutionReasonCodes"
              }
            }
          }
        },
        {
          "if": {
            "required": ["classification"],
            "properties": {
              "classification": {
                "const": "fail"
              }
            }
          },
          "then": {
            "properties": {
              "reason_codes": {
                "$ref": "#/$defs/failExecutionReasonCodes"
              }
            }
          }
        },
        {
          "if": {
            "required": ["classification"],
            "properties": {
              "classification": {
                "const": "error"
              }
            }
          },
          "then": {
            "properties": {
              "reason_codes": {
                "$ref": "#/$defs/errorExecutionReasonCodes"
              }
            }
          }
        },
        {
          "if": {
            "required": ["classification"],
            "properties": {
              "classification": {
                "const": "skipped"
              }
            }
          },
          "then": {
            "properties": {
              "reason_codes": {
                "$ref": "#/$defs/skippedExecutionReasonCodes"
              }
            }
          }
        },
        {
          "if": {
            "required": ["timed_out"],
            "properties": {
              "timed_out": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "classification": {
                "const": "error"
              },
              "reason_codes": {
                "contains": {
                  "const": "COMMAND_TIMED_OUT"
                }
              }
            }
          }
        },
        {
          "if": {
            "required": ["reason_codes"],
            "properties": {
              "reason_codes": {
                "contains": {
                  "const": "COMMAND_TIMED_OUT"
                }
              }
            }
          },
          "then": {
            "properties": {
              "timed_out": {
                "const": true
              }
            }
          }
        },
        {
          "properties": {
            "reason_codes": {
              "contains": {
                "enum": [
                  "COMMAND_EXIT_ERROR",
                  "COMMAND_EXIT_UNCLASSIFIED",
                  "COMMAND_FAILED",
                  "COMMAND_SIGNALLED",
                  "COMMAND_SPAWN_FAILED",
                  "COMMAND_TIMED_OUT",
                  "INHERITED_ENVIRONMENT_MISSING",
                  "OPERATOR_INTERRUPTED"
                ]
              },
              "minContains": 0,
              "maxContains": 1
            }
          }
        },
        {
          "if": {
            "required": ["phase"],
            "properties": {
              "phase": {
                "const": "prepare"
              }
            }
          },
          "then": {
            "properties": {
              "metrics": {
                "const": {}
              },
              "reason_codes": {
                "not": {
                  "contains": {
                    "const": "OPTIONAL_REPORT_MISSING"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "artifactPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "description": "POSIX-separated artifact path with at most 32 components; each 1-128-code-point component obeys the portable grammar, while NFC and casefold rules are semantic.",
      "pattern": "^[^/]+(?:/[^/]+){0,31}$",
      "allOf": [
        {
          "not": {
            "pattern": "[<>:\"\\\\|?*\\u0000-\\u001F\\u007F]"
          }
        },
        {
          "not": {
            "pattern": "(?:^|/)\\.{1,2}(?:/|$)"
          }
        },
        {
          "not": {
            "pattern": "[ .](?:/|$)"
          }
        },
        {
          "not": {
            "pattern": "(?:^|/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.[^/]*)?(?:/|$)"
          }
        },
        {
          "not": {
            "pattern": "(?:^|/)[^/]{129}"
          }
        },
        {
          "not": {
            "pattern": "^[Mm][Aa][Nn][Ii][Ff][Ee][Ss][Tt]\\.[Jj][Ss][Oo][Nn]$"
          }
        }
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "media_type",
        "size_bytes",
        "sha256",
        "truncated"
      ],
      "properties": {
        "path": {
          "allOf": [
            {
              "$ref": "#/$defs/artifactPath"
            },
            {
              "not": {
                "const": "manifest.json"
              }
            }
          ]
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 209715200
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "truncated": {
          "type": "boolean"
        },
        "original_size_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "full_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["truncated"],
            "properties": {
              "truncated": {
                "const": true
              }
            }
          },
          "then": {
            "required": ["original_size_bytes", "full_sha256"]
          }
        }
      ]
    },
    "scalar": {
      "anyOf": [
        {
          "type": "number",
          "minimum": -1.7976931348623157e308,
          "maximum": 1.7976931348623157e308
        },
        {
          "type": "string",
          "maxLength": 4096
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "executionReasonCodes": {
      "type": "array",
      "maxItems": 15,
      "uniqueItems": true,
      "items": {
        "enum": [
          "COMMAND_EXIT_ERROR",
          "COMMAND_EXIT_UNCLASSIFIED",
          "COMMAND_FAILED",
          "COMMAND_SIGNALLED",
          "COMMAND_SPAWN_FAILED",
          "COMMAND_TIMED_OUT",
          "CONTROL_LAUNCHER_REVIEW",
          "EVIDENCE_BUDGET_EXHAUSTED",
          "INHERITED_ENVIRONMENT_MISSING",
          "OPERATOR_INTERRUPTED",
          "OPTIONAL_REPORT_MISSING",
          "POLICY_FILE_CHANGED",
          "PREPARATION_FAILED",
          "REQUIRED_CONTROL_SKIPPED",
          "STREAM_TRUNCATED"
        ]
      }
    },
    "passExecutionReasonCodes": {
      "type": "array",
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": ["OPTIONAL_REPORT_MISSING", "STREAM_TRUNCATED"]
      }
    },
    "failExecutionReasonCodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": ["COMMAND_FAILED", "OPTIONAL_REPORT_MISSING", "STREAM_TRUNCATED"]
      },
      "contains": {
        "const": "COMMAND_FAILED"
      }
    },
    "errorExecutionReasonCodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 9,
      "uniqueItems": true,
      "items": {
        "enum": [
          "COMMAND_EXIT_ERROR",
          "COMMAND_EXIT_UNCLASSIFIED",
          "COMMAND_SIGNALLED",
          "COMMAND_SPAWN_FAILED",
          "COMMAND_TIMED_OUT",
          "EVIDENCE_BUDGET_EXHAUSTED",
          "INHERITED_ENVIRONMENT_MISSING",
          "OPERATOR_INTERRUPTED",
          "STREAM_TRUNCATED"
        ]
      },
      "contains": {
        "enum": [
          "COMMAND_EXIT_ERROR",
          "COMMAND_EXIT_UNCLASSIFIED",
          "COMMAND_SIGNALLED",
          "COMMAND_SPAWN_FAILED",
          "COMMAND_TIMED_OUT",
          "EVIDENCE_BUDGET_EXHAUSTED",
          "INHERITED_ENVIRONMENT_MISSING",
          "OPERATOR_INTERRUPTED"
        ]
      }
    },
    "skippedExecutionReasonCodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "enum": [
          "CONTROL_LAUNCHER_REVIEW",
          "EVIDENCE_BUDGET_EXHAUSTED",
          "OPERATOR_INTERRUPTED",
          "POLICY_FILE_CHANGED",
          "PREPARATION_FAILED",
          "REQUIRED_CONTROL_SKIPPED"
        ]
      }
    }
  }
}
