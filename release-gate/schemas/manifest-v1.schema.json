{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:release-gate:schema:manifest:v1",
  "title": "Release Gate evidence manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "run_id",
    "hash_algorithm",
    "created_at",
    "started_at",
    "finished_at",
    "duration_ms",
    "base_commit",
    "candidate_tree",
    "patch_sha256",
    "config_sha256",
    "engine_version",
    "platform",
    "runtime",
    "reason_codes",
    "executions",
    "artifacts"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "run_id": {
      "$ref": "#/$defs/runId"
    },
    "hash_algorithm": {
      "const": "sha256"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "base_commit": {
      "$ref": "#/$defs/gitObject"
    },
    "candidate_tree": {
      "$ref": "#/$defs/gitObject"
    },
    "patch_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "config_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "engine_version": {
      "type": "string",
      "minLength": 1
    },
    "platform": {
      "$ref": "#/$defs/platformIdentity"
    },
    "runtime": {
      "$ref": "#/$defs/runtimeIdentity"
    },
    "reason_codes": {
      "$ref": "#/$defs/reasonCodes"
    },
    "executions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/execution"
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    }
  },
  "$defs": {
    "runId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitObject": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "reasonCodes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]*$"
      }
    },
    "platformIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "system", "release", "machine"],
      "properties": {
        "family": {
          "enum": ["linux", "macos", "windows"]
        },
        "system": {
          "type": "string",
          "minLength": 1
        },
        "release": {
          "type": "string",
          "minLength": 1
        },
        "machine": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "runtimeIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation", "version", "executable", "executable_sha256"],
      "properties": {
        "implementation": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "executable": {
          "type": "string",
          "minLength": 1
        },
        "executable_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id",
        "phase",
        "side",
        "argv",
        "cwd",
        "environment_keys",
        "started_at",
        "finished_at",
        "duration_ms",
        "classification",
        "exit_code",
        "timed_out",
        "reason_codes",
        "metrics"
      ],
      "properties": {
        "check_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{0,63}$"
        },
        "phase": {
          "enum": ["prepare", "check"]
        },
        "side": {
          "enum": ["base", "candidate"]
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "cwd": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
        },
        "environment_keys": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "finished_at": {
          "type": "string",
          "format": "date-time"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "classification": {
          "enum": ["pass", "fail", "error", "skipped"]
        },
        "exit_code": {
          "type": ["integer", "null"],
          "minimum": -2147483648,
          "maximum": 4294967295
        },
        "timed_out": {
          "type": "boolean"
        },
        "reason_codes": {
          "$ref": "#/$defs/reasonCodes"
        },
        "metrics": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "media_type",
        "size_bytes",
        "sha256",
        "truncated"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "truncated": {
          "type": "boolean"
        },
        "original_size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "full_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["truncated"],
            "properties": {
              "truncated": {
                "const": true
              }
            }
          },
          "then": {
            "required": ["original_size_bytes", "full_sha256"]
          }
        }
      ]
    }
  }
}
